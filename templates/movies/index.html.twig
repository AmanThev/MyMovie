
{% extends 'base.html.twig' %}

{% block title %}MyMovies{% endblock %}

{% block body %}

<div class="header">
    <div class="container movies-header">
        <h1>🎬 MyMovies</h1>
        <a href="{{ path('app_movies_new') }}" class="btn-add">+ Add Movie</a>
    </div>
</div>

<main class="container">
    <div class="library-header">
        <h2>My Movies</h2>
        <span class="movie-count">{{ movies|length }} movies</span>
    </div>

    <div class="movies-grid">
        {% for movie in movies %}
            <article class="movie-card">
                <a href="{{ path('app_movies_show', {'id': movie.id}) }}" class="movie-poster-link">
                    {% if movie.posterPath %}
                        <img src="https://image.tmdb.org/t/p/w500{{ movie.posterPath }}" alt="Poster of {{ movie.title }}" class="movie-poster" loading="lazy">
                    {% else %}
                        <div class="movie-poster-placeholder">
                            🎬
                        </div>
                    {% endif %}
                </a>
                <div class="movie-card-content">
                    <h3>{{ movie.title }}</h3>
                    <p class="movie-info">
                        {{ movie.releaseYear }} ·
                        {{ movie.duration }} min
                    </p>
                    <p class="movie-description">{{ movie.description }}</p>
                    <a href="{{ path('app_movies_show', {'id': movie.id}) }}" class="btn movie-view-btn">View Details</a>
                </div>

            </article>

        {% else %}
            <p>No movies in your library yet.</p>
        {% endfor %}
    </div>
</main>
{% endblock %}

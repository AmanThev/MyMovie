{% extends 'base.html.twig' %}

{% block title %}Mes films{% endblock %}

{% block body %}

<div class="header">
    <div class="container">
        <h1>🎬 MyMovies</h1>
    </div>
</div>

<main class="container">

    <h2>Mes films</h2>

    <div class="movies-grid">

        {% for movie in movies %}

            <article class="movie-card">

                <h2>{{ movie.title }}</h2>

                <p class="movie-info">
                    {{ movie.releaseYear }} · {{ movie.duration }} minutes
                </p>

                <p>
                    {{ movie.description }}
                </p>

                <a href="{{ path('app_movies_show', {id: movie.id}) }}" class="btn">
                    Voir le film
                </a>

            </article>

        {% endfor %}

    </div>

</main>

{% endblock %}
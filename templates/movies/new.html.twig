{% extends 'base.html.twig' %}

{% block title %}Mes films{% endblock %}

{% block body %}

<div class="header">
    <div class="container">
        <h1>🎬 MyMovies</h1>
    </div>
</div>

<main class="container">

    <h1>Add a new movie</h1>
    {{ form_start(form) }}

        {{ form_row(form.title) }}

        {{ form_row(form.releaseYear) }}

        {{ form_row(form.duration) }}

        {{ form_row(form.description) }}

        {{ form_row(form.save) }}

    {{ form_end(form) }}

</main>

{% endblock %}
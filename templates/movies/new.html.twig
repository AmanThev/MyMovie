
{% extends 'base.html.twig' %}

{% block title %}Add Movie{% endblock %}

{% block body %}

<div class="movie-form-container">
    <h1>Add New Movie</h1>

    {# Recherche TMDB #}
    <form method="get"
          action="{{ path('app_movies_new') }}"
          class="tmdb-search">

        <label for="search">Search movie on TMDB</label>

        <div class="tmdb-search-row">
            <input
                type="text"
                id="search"
                name="search"
                placeholder="Enter a movie title..."
                value="{{ app.request.query.get('search')|default('') }}"
                required
            >

            <button type="submit" class="btn-search">
                Search
            </button>
        </div>
    </form>

    {# Résultats TMDB #}
    {% if searchResults is not empty %}
        <div class="tmdb-results">
            <h3>Search Results</h3>

            {% for result in searchResults %}
                <div class="tmdb-result">

                    {% if result.poster_path %}
                        <img
                            src="https://image.tmdb.org/t/p/w185{{ result.poster_path }}"
                            alt="{{ result.title }}"
                        >
                    {% endif %}

                    <div class="tmdb-result-info">
                        <h4>{{ result.title }}</h4>

                        <p>
                            {{ result.release_date|default('Unknown date') }}
                        </p>

                        <a
                            href="{{ path('app_movies_new', {'tmdb_id': result.id}) }}"
                            class="btn-select"
                        >
                            Select Movie
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    {# Formulaire Symfony : ajout du film #}
    {{ form_start(form, {'attr': {'class': 'movie-form'}}) }}

        <div class="form-group">
            {{ form_label(form.title) }}
            {{ form_widget(form.title) }}
            {{ form_errors(form.title) }}
        </div>

        <div class="form-row">
            <div class="form-group">
                {{ form_label(form.releaseYear) }}
                {{ form_widget(form.releaseYear) }}
                {{ form_errors(form.releaseYear) }}
            </div>

            <div class="form-group">
                {{ form_label(form.duration) }}
                {{ form_widget(form.duration) }}
                {{ form_errors(form.duration) }}
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.description) }}
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
        </div>

        <div class="form-actions">
            <button type="submit" class="btn">
                + Add Movie
            </button>

            <a href="{{ path('app_movies') }}" class="btn-cancel">
                Cancel
            </a>
        </div>

    {{ form_end(form) }}

</div>

{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}{{ movie.title }}{% endblock %}

{% block body %}

<div class="header">
    <div class="container">
        <a href="{{ path('app_movies') }}">
            🎬 MyMovies
        </a>
    </div>
</div>

<main class="container">

    <article class="movie-detail">

        <h1>{{ movie.title }}</h1>

        <div class="info">

            <span>📅 {{ movie.releaseYear }}</span>

            <span>⏱️ {{ movie.duration }} min</span>

        </div>

        <div class="description">
            <p>
                {{ movie.description }}
            </p>
        </div>

        <a href="{{ path('app_movies') }}" class="btn">
            ← Retour aux films
        </a>

    </article>

</main>

{% endblock %}
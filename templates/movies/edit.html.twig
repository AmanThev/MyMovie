{% extends 'base.html.twig' %}

{% block title %}Edit Movie{% endblock %}

{% block body %}

<div class="movie-form-container">

    <h1>Edit Movie: {{ movie.title }}</h1>

    {{ form_start(form, {'attr': {'class': 'movie-form'}}) }}

        <div class="form-group">
            {{ form_label(form.title) }}
            {{ form_widget(form.title) }}
            {{ form_errors(form.title) }}
        </div>

        <div class="form-row">
            <div class="form-group">
                {{ form_label(form.releaseYear) }}
                {{ form_widget(form.releaseYear) }}
                {{ form_errors(form.releaseYear) }}
            </div>

            <div class="form-group">
                {{ form_label(form.duration) }}
                {{ form_widget(form.duration) }}
                {{ form_errors(form.duration) }}
            </div>
        </div>

        <div class="form-group">
            {{ form_label(form.description) }}
            {{ form_widget(form.description) }}
            {{ form_errors(form.description) }}
        </div>

        <div class="form-actions">
            <button type="submit" class="btn">Update Movie</button>
            <a href="{{ path('app_movies_show', {'id': movie.id}) }}" class="btn-cancel">Cancel</a>
        </div>

    {{ form_end(form) }}

</div>

{% endblock %}